[Unit]
Description=Arif multimodal chatbot backend
After=network.target nemotron-llama.service
Wants=nemotron-llama.service

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/Arif/backend
Environment=PYTHONPATH=/home/%i/Arif/backend
EnvironmentFile=/home/%i/Arif/.env
ExecStart=/home/%i/Arif/.venv/bin/python run.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
