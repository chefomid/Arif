#!/usr/bin/env bash
# Arif — detect (YOLO) | chat (terminal LLM)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

if [[ -x "$ROOT/.venv/bin/python" ]]; then
  PYTHON="$ROOT/.venv/bin/python"
elif command -v python3 &>/dev/null; then
  PYTHON="python3"
else
  PYTHON="python"
fi

case "${1:-chat}" in
  detect)
    exec "$PYTHON" "$ROOT/detect.py" "${@:2}"
    ;;
  chat|"")
    exec "$PYTHON" "$ROOT/chat.py" "${@:2}"
    ;;
  *)
    echo "Usage: arif [chat] | arif detect"
    exit 1
    ;;
esac
