#!/usr/bin/env bash
# Start Arif: llama-server (Nemotron) + FastAPI backend in one command.
set -euo pipefail

# Resolve real path when ~/bin/arif is a symlink (otherwise ARIF_ROOT becomes $HOME).
_arif_script="${BASH_SOURCE[0]}"
if command -v readlink &>/dev/null; then
  _arif_script="$(readlink -f "$_arif_script" 2>/dev/null || echo "$_arif_script")"
elif command -v realpath &>/dev/null; then
  _arif_script="$(realpath "$_arif_script" 2>/dev/null || echo "$_arif_script")"
fi
ARIF_ROOT="$(cd "$(dirname "$_arif_script")/.." && pwd)"
cd "$ARIF_ROOT"

if [[ -f "$ARIF_ROOT/scripts/configure-env.sh" ]]; then
  bash "$ARIF_ROOT/scripts/configure-env.sh" --quiet
fi

if [[ -f "$ARIF_ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$ARIF_ROOT/.env"
  set +a
fi

MODEL="${ARIF_MODEL:-models/NVIDIA-Nemotron3-Nano-4B-Q4_K_M.gguf}"
LLM_HOST="${LLM_HOST:-0.0.0.0}"
LLM_PORT="${LLM_PORT:-8080}"
ARIF_PORT="${ARIF_PORT:-8000}"
LLM_ALIAS="${LLM_ALIAS:-nemotron}"

log() { printf '\033[1;36m[arif]\033[0m %s\n' "$*"; }
err() { printf '\033[1;31m[arif]\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[arif]\033[0m %s\n' "$*"; }

is_jetson() {
  [[ "$(uname -m)" == "aarch64" ]] && {
    [[ -f /etc/nv_tegra_release ]] || grep -qi nvidia /proc/device-tree/model 2>/dev/null
  }
}

truthy() {
  case "${1,,}" in
    1 | true | yes | on) return 0 ;;
    *) return 1 ;;
  esac
}

mem_total_gb() {
  awk '/MemTotal:/ {printf "%d", $2/1024/1024}' /proc/meminfo 2>/dev/null || echo 0
}

mem_avail_mb() {
  awk '/MemAvailable:/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0
}

# Defaults tuned for 8GB Jetson unified memory
_mem_gb="$(mem_total_gb)"
if [[ -z "${LLM_CTX_SIZE+x}" ]]; then
  if is_jetson && [[ "$_mem_gb" -gt 0 && "$_mem_gb" -le 9 ]]; then
    LLM_CTX_SIZE=2048
  else
    LLM_CTX_SIZE=4096
  fi
fi

if [[ -z "${ARIF_ENGAGE_GPU+x}" ]]; then
  ARIF_ENGAGE_GPU=false
fi

if [[ -z "${ARIF_LLM_AUTO_FIT+x}" ]]; then
  ARIF_LLM_AUTO_FIT=false
fi

if [[ -z "${LLM_GPU_LAYERS+x}" ]]; then
  LLM_GPU_LAYERS=0
fi

if truthy "$ARIF_ENGAGE_GPU" && is_jetson; then
  if [[ -f "$ARIF_ROOT/scripts/jetson-gpu-prep.sh" ]]; then
    bash "$ARIF_ROOT/scripts/jetson-gpu-prep.sh" || warn "GPU prep had warnings (continuing)"
  fi
fi

LLAMA_PID=""
STARTED_LLAMA=0
LLAMA_LOG=""

cleanup() {
  if [[ "$STARTED_LLAMA" -eq 1 && -n "$LLAMA_PID" ]]; then
    log "Stopping llama-server (pid $LLAMA_PID)..."
    kill "$LLAMA_PID" 2>/dev/null || true
    wait "$LLAMA_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

find_llama_server() {
  if command -v llama-server &>/dev/null; then
    command -v llama-server
    return 0
  fi
  for p in \
    /usr/local/bin/llama-server \
    "$HOME/llama.cpp/build/bin/llama-server" \
    /opt/llama.cpp/build/bin/llama-server \
    /opt/llama.cpp/llama-server; do
    if [[ -x "$p" ]]; then
      echo "$p"
      return 0
    fi
  done
  return 1
}

port_open() {
  local port=$1
  if command -v ss &>/dev/null; then
    ss -ltn 2>/dev/null | grep -q ":${port} "
  elif command -v nc &>/dev/null; then
    nc -z 127.0.0.1 "$port" 2>/dev/null
  else
    timeout 1 bash -c "echo >/dev/tcp/127.0.0.1/${port}" 2>/dev/null
  fi
}

llm_ready() {
  curl -sf "http://127.0.0.1:${LLM_PORT}/health" >/dev/null 2>&1 \
    || curl -sf "http://127.0.0.1:${LLM_PORT}/v1/models" >/dev/null 2>&1
}

wait_for_llm() {
  local max_wait=${1:-90}
  local i
  for ((i = 1; i <= max_wait; i++)); do
    if llm_ready; then
      return 0
    fi
    sleep 2
  done
  return 1
}

kill_started_llama() {
  if [[ -n "${LLAMA_PID:-}" ]] && kill -0 "$LLAMA_PID" 2>/dev/null; then
    kill "$LLAMA_PID" 2>/dev/null || true
    wait "$LLAMA_PID" 2>/dev/null || true
  fi
  pkill -f "llama-server.*${LLM_PORT}" 2>/dev/null || true
  LLAMA_PID=""
  STARTED_LLAMA=0
}

llama_failed_oom() {
  [[ -f "${LLAMA_LOG:-}" ]] || return 1
  grep -qiE 'out of memory|cudaMalloc failed|unable to allocate CUDA|error loading model' "$LLAMA_LOG"
}

# Extra llama-server flags only if this binary supports them (avoids instant exit).
llama_extra_args() {
  local llama_bin=$1
  local help
  help="$("$llama_bin" --help 2>&1 || true)"
  if grep -q -- '--parallel' <<<"$help"; then
    printf '%s\n' --parallel 1
  fi
}

tier_wait_seconds() {
  local ngl=$1
  if [[ "$ngl" == "0" ]]; then
    echo 360
  elif [[ "$ngl" -lt 32 ]]; then
    echo 240
  else
    echo 90
  fi
}

# Build try-order for n-gpu-layers (deduped). On 8GB Jetson: CPU first so chat works.
gpu_layer_tiers() {
  local avail_mb=$1
  local requested=$2
  local mem_gb=$3
  local -a tiers=()
  local -A seen=()

  add_tier() {
    local t=$1
    [[ -n "${seen[$t]:-}" ]] && return
    seen[$t]=1
    tiers+=("$t")
  }

  # With auto-fit, ignore LLM_GPU_LAYERS=999 in .env — always use safe CPU-first order.
  if [[ "$requested" != "auto" && -n "$requested" ]] && ! truthy "${ARIF_LLM_AUTO_FIT:-false}"; then
    add_tier "$requested"
  fi

  if is_jetson && [[ "$mem_gb" -gt 0 && "$mem_gb" -le 9 ]]; then
    add_tier 0 8 16 32 48 64 999
  elif [[ "$avail_mb" -lt 2800 ]]; then
    add_tier 0
  elif [[ "$avail_mb" -lt 3800 ]]; then
    add_tier 0 8 16
  elif [[ "$avail_mb" -lt 4800 ]]; then
    add_tier 0 16 32 8
  else
    add_tier 0 8 16 32 48 64 999
  fi

  printf '%s\n' "${tiers[@]}"
}

start_llama_with_fallback() {
  local llama_bin=$1
  local avail_mb mem_gb max_wait ngl tiers_ok=0 tier_n=0 tier_total
  local -a extra_args=()

  avail_mb="$(mem_avail_mb)"
  mem_gb="$(mem_total_gb)"
  mapfile -t _tiers < <(gpu_layer_tiers "$avail_mb" "${LLM_GPU_LAYERS}" "$mem_gb")
  tier_total="${#_tiers[@]}"

  log "MemAvailable: ${avail_mb} MB — trying ${tier_total} configs (ctx=${LLM_CTX_SIZE}, CPU-first on 8GB)"

  read -ra extra_args < <(llama_extra_args "$llama_bin")

  LLAMA_LOG="$(mktemp /tmp/arif-llama.XXXXXX.log)"

  for ngl in "${_tiers[@]}"; do
    tier_n=$((tier_n + 1))
    kill_started_llama
    sleep 2
    max_wait="$(tier_wait_seconds "$ngl")"
    log "[$tier_n/$tier_total] llama-server n-gpu-layers=${ngl} (wait up to ${max_wait}s) ..."
    : >"$LLAMA_LOG"
    "$llama_bin" \
      -m "$ARIF_ROOT/$MODEL" \
      --host "$LLM_HOST" \
      --port "$LLM_PORT" \
      --ctx-size "$LLM_CTX_SIZE" \
      --n-gpu-layers "$ngl" \
      "${extra_args[@]}" \
      --alias "$LLM_ALIAS" \
      >"$LLAMA_LOG" 2>&1 &
    LLAMA_PID=$!
    STARTED_LLAMA=1

    local waited=0
    while ((waited < max_wait)); do
      if llm_ready; then
        LLM_GPU_LAYERS=$ngl
        tiers_ok=1
        log "llama-server ready (n-gpu-layers=${ngl}, ctx=${LLM_CTX_SIZE})"
        rm -f "$LLAMA_LOG"
        LLAMA_LOG=""
        return 0
      fi
      if ! kill -0 "$LLAMA_PID" 2>/dev/null; then
        warn "llama-server exited early (n-gpu-layers=${ngl})"
        tail -8 "$LLAMA_LOG" 2>/dev/null | while read -r line; do warn "  $line"; done
        break
      fi
      if llama_failed_oom; then
        warn "CUDA OOM at n-gpu-layers=${ngl} — next tier..."
        kill_started_llama
        break
      fi
      sleep 2
      waited=$((waited + 2))
    done
    kill_started_llama
    if ((waited >= max_wait)); then
      warn "Timed out waiting for n-gpu-layers=${ngl}"
    fi
  done

  if [[ "$tiers_ok" -eq 0 ]]; then
    mkdir -p "$ARIF_ROOT/logs"
    local persist_log="$ARIF_ROOT/logs/llama-last.log"
    cp -f "$LLAMA_LOG" "$persist_log" 2>/dev/null || true
    err "Nemotron failed to load at all GPU/CPU tiers."
    err "Full log: $persist_log"
    err "View: arif logs   or: cat $persist_log"
    tail -40 "$persist_log" >&2 || true
    LLAMA_LOG=""
    return 1
  fi
  return 0
}

show_urls() {
  local ip
  ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  log "UI:  http://127.0.0.1:${ARIF_PORT}"
  if [[ -n "${ip:-}" ]]; then
    log "LAN: http://${ip}:${ARIF_PORT}"
  fi
  log "Press Ctrl+C to stop."
}

cmd_stop() {
  local killed=0
  if port_open "$LLM_PORT"; then
    pkill -f "llama-server.*${LLM_PORT}" 2>/dev/null && killed=1 || true
  fi
  if port_open "$ARIF_PORT"; then
    pkill -f "python.*run.py" 2>/dev/null && killed=1 || true
  fi
  if [[ "$killed" -eq 1 ]]; then
    log "Stopped Arif / llama-server processes."
  else
    log "Nothing running on ports ${LLM_PORT} / ${ARIF_PORT}."
  fi
  trap - EXIT INT TERM
  exit 0
}

case "${1:-start}" in
  stop)
    cmd_stop
    ;;
  start|"")
    ;;
  gpu-prep)
    if [[ -f "$ARIF_ROOT/scripts/jetson-gpu-prep.sh" ]]; then
      bash "$ARIF_ROOT/scripts/jetson-gpu-prep.sh"
    else
      err "scripts/jetson-gpu-prep.sh not found"
      exit 1
    fi
    trap - EXIT INT TERM
    exit 0
    ;;
  cleanup)
    if [[ -f "$ARIF_ROOT/scripts/disk-cleanup.sh" ]]; then
      bash "$ARIF_ROOT/scripts/disk-cleanup.sh" "${2:-}"
    else
      err "scripts/disk-cleanup.sh not found"
      exit 1
    fi
    trap - EXIT INT TERM
    exit 0
    ;;
  configure)
    bash "$ARIF_ROOT/scripts/configure-env.sh"
    trap - EXIT INT TERM
    exit 0
    ;;
  update)
    bash "$ARIF_ROOT/scripts/jetson-update.sh"
    trap - EXIT INT TERM
    exit 0
    ;;
  logs)
    if [[ -f "$ARIF_ROOT/logs/llama-last.log" ]]; then
      less "$ARIF_ROOT/logs/llama-last.log" 2>/dev/null || cat "$ARIF_ROOT/logs/llama-last.log"
    else
      err "No log yet. Run: arif   then on failure: cat logs/llama-last.log"
      ls -la /tmp/arif-llama.*.log 2>/dev/null || true
    fi
    trap - EXIT INT TERM
    exit 0
    ;;
  *)
    err "Usage: arif [start|stop|update|configure|cleanup|logs|gpu-prep]"
    exit 1
    ;;
esac

if [[ ! -f "$ARIF_ROOT/$MODEL" ]]; then
  err "Model not found: $ARIF_ROOT/$MODEL"
  err "Repo root: $ARIF_ROOT"
  err "Run from repo:  cd \"$ARIF_ROOT\" && bash models/download_models.sh"
  err "Or start via:   bash \"$ARIF_ROOT/arif\""
  exit 1
fi

if [[ ! -f "$ARIF_ROOT/.venv/bin/python" ]]; then
  err "Python venv missing. Run: bash scripts/install-python.sh"
  exit 1
fi

if ! "$ARIF_ROOT/.venv/bin/python" -c 'import sys; exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
  err "Python 3.11+ required in .venv (found older interpreter)."
  err "  bash scripts/install-python.sh"
  exit 1
fi

mkdir -p "$ARIF_ROOT/logs"

# --- llama-server ---
if llm_ready; then
  log "llama-server already responding on port ${LLM_PORT} — reusing it."
else
  LLAMA_BIN="$(find_llama_server)" || {
    err "llama-server not found."
    err "Install it on the Jetson (one time, ~15–30 min):"
    err "  cd ~/Arif && bash scripts/install-llama-server.sh"
    err "Guide: https://www.jetson-ai-lab.com/models/nemotron3-nano-4b/"
    exit 1
  }
  if port_open "$LLM_PORT"; then
    err "Port ${LLM_PORT} is in use but llama-server is not healthy yet. Stop the other process or run: arif stop"
    exit 1
  fi
  if truthy "${ARIF_LLM_AUTO_FIT:-false}"; then
    start_llama_with_fallback "$LLAMA_BIN" || exit 1
  else
    log "Starting Nemotron on CPU (n-gpu-layers=${LLM_GPU_LAYERS}, ctx=${LLM_CTX_SIZE})..."
    if [[ "$LLM_GPU_LAYERS" != "0" ]]; then
      warn "LLM_GPU_LAYERS=${LLM_GPU_LAYERS} uses GPU; set LLM_GPU_LAYERS=0 for CPU-only"
    fi
    read -ra _extra < <(llama_extra_args "$LLAMA_BIN")
    mkdir -p "$ARIF_ROOT/logs"
    LLAMA_LOG="$ARIF_ROOT/logs/llama-last.log"
    : >"$LLAMA_LOG"
    "$LLAMA_BIN" \
      -m "$ARIF_ROOT/$MODEL" \
      --host "$LLM_HOST" \
      --port "$LLM_PORT" \
      --ctx-size "$LLM_CTX_SIZE" \
      --n-gpu-layers "$LLM_GPU_LAYERS" \
      "${_extra[@]}" \
      --alias "$LLM_ALIAS" \
      >"$LLAMA_LOG" 2>&1 &
    LLAMA_PID=$!
    STARTED_LLAMA=1
    log "Waiting for llama-server (pid $LLAMA_PID, log: logs/llama-last.log)..."
    if ! wait_for_llm 180; then
      err "llama-server did not become ready (CPU load can take several minutes)."
      err "Check: arif logs   or: tail -40 logs/llama-last.log"
      tail -20 "$LLAMA_LOG" >&2 || true
      exit 1
    fi
    log "llama-server ready."
  fi
fi

# --- backend ---
if port_open "$ARIF_PORT"; then
  err "Port ${ARIF_PORT} already in use. Run: arif stop"
  exit 1
fi

log "Starting Arif backend..."
show_urls

# Don't kill llama on backend exit if user only wanted backend crash to exit all - trap handles it
source "$ARIF_ROOT/.venv/bin/activate"
cd "$ARIF_ROOT/backend"
exec python run.py
