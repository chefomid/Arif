# YOLO detection
YOLO_MODEL=models/yolo11n.pt
YOLO_CONFIDENCE=0.4
CAMERA_DEVICE=0

# LLM chat
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=not-needed
LLM_GPU_LAYERS=0
LLM_READY_TIMEOUT_SEC=0

# Light model (fast — default when you pick 1)
LLM_LIGHT_MODEL_PATH=models/qwen2.5-0.5b-instruct-q4_k_m.gguf
LLM_LIGHT_MODEL=light
LLM_LIGHT_CTX_SIZE=512

# Heavy model (better — when you pick 2)
LLM_HEAVY_MODEL_PATH=models/NVIDIA-Nemotron3-Nano-4B-Q4_K_M.gguf
LLM_HEAVY_MODEL=nemotron
LLM_HEAVY_CTX_SIZE=1024
