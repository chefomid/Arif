# Backend
ARIF_HOST=0.0.0.0
ARIF_PORT=8000
ARIF_DEBUG=false

# LLM (llama-server / Nemotron) — CPU-only on Jetson 8GB (stable, no CUDA OOM)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=nemotron
LLM_API_KEY=not-needed
ARIF_ENGAGE_GPU=false
ARIF_LLM_AUTO_FIT=false
LLM_GPU_LAYERS=0
LLM_CTX_SIZE=2048

# STT
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# VAD
VAD_SILENCE_SECONDS=3.0
VAD_SAMPLE_RATE=16000

# Microphone (sounddevice index; leave empty for auto-detect on startup)
# MIC_DEVICE=1

# Camera (ELP stereo)
CAMERA_DEVICE=0
CAMERA_WIDTH=1600
CAMERA_HEIGHT=600
CAMERA_STEREO=true
CAMERA_FPS=30

# YOLO
YOLO_MODEL=models/yolo11n.engine
YOLO_CONFIDENCE=0.4
YOLO_FPS_CAP=8

# Scene memory
SCENE_MEMORY_MINUTES=10
SCENE_KEYFRAME_FPS=1
SCENE_SUMMARY_INTERVAL_SEC=5

# Orchestrator
GPU_TEMP_THROTTLE_C=80
YOLO_FPS_MIN=2
