# YOLO detection
YOLO_MODEL=models/yolo11n.pt
YOLO_CONFIDENCE=0.4
CAMERA_DEVICE=0

# LLM chat (llama-server auto-starts when you run: arif chat)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=nemotron
LLM_API_KEY=not-needed
LLM_MODEL_PATH=models/NVIDIA-Nemotron3-Nano-4B-Q4_K_M.gguf
LLM_GPU_LAYERS=0
LLM_CTX_SIZE=2048
# First load wait (0 = auto: 900s CPU on Jetson, 600s CPU elsewhere)
LLM_READY_TIMEOUT_SEC=0
